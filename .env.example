# 内容抓取流水线配置：复制为 .env 后填写（.env 不进入版本库）
# 语音转写（阿里云百炼 DashScope，OpenAI 之外的独立通道）
STT_PROVIDER=dashscope_flash
STT_BASE_URL=https://dashscope.aliyuncs.com/api/v1
STT_MODEL=qwen3.5-omni-plus
STT_API_KEY=

# 知识稿撰写模型（任何 OpenAI 兼容接口）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
LLM_API_KEY=
# 思考型模型建议关闭思考，避免输出额度全部耗在推理上
LLM_ENABLE_THINKING=false

# 可选：单次转写的音频切片时长（秒）。切片越短越稳，调用次数越多
AUDIO_CHUNK_SECONDS=240
# 可选：知识稿模型输出上限（Token）。思考型模型会先花额度推理，必须给足
LLM_MAX_TOKENS=32000
